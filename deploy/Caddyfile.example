receiver.obsidianwatch.org {
    encode zstd gzip

    handle /webhook {
        reverse_proxy 127.0.0.1:8765
    }

    handle /events* {
        reverse_proxy 127.0.0.1:8765
    }

    handle /healthz {
        reverse_proxy 127.0.0.1:8765
    }

    handle {
        respond "Not found" 404
    }

    log {
        output file /var/log/caddy/gitget-receiver.access.log
        format json
    }
}
